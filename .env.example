# Токен від @BotFather
BOT_TOKEN=

# Твій Telegram user id (число). Кілька адмінів через кому.
# Дізнатись: @userinfobot або @getidsbot
ADMIN_IDS=

# Публічний HTTPS-адрес Mini App (без слеша в кінці).
# Локально: cloudflared tunnel --url http://localhost:3000
WEBAPP_URL=

PORT=3000
TZ=Europe/Kyiv
COMPANY_NAME=King Kong Lab

# 1 = webhook замість long polling (коли вже є публічний URL)
USE_WEBHOOK=0
WEBHOOK_SECRET=

# Лише для локального превʼю без Telegram: відкрий http://localhost:3000/?dev=ТВІЙ_TG_ID
DEV_MODE=0

# ── Додаткові можливості (необовʼязково) ──
# Голосові повідомлення й фото чеків → операції. Ключ з platform.openai.com
OPENAI_API_KEY=
# Monobank: особистий токен з https://api.monobank.ua/ — надходження стають операціями автоматично
MONO_TOKEN=
# Секрет для синхронізації з Google-таблицею (будь-який довгий рядок; той самий вставити в Apps Script)
SHEET_SYNC_TOKEN=
